	"info": {
		"title": "ffastrans-rest-api",
		"version": "2.5.0",
		"description": "FFAStrans REST API",
		"contact": {}
	},
	"paths": {
		"/api/v2/workflows": {
			"get": {
				"operationId": "ListWorkflows",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WorkflowsResponse"
								}
							}
						}
					}
				},
				"description": "Retrieves workflows and requested monitor state. The legacy status running\nindicates a shared start marker, without verifying runner health or job execution.",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": []
			},
			"post": {
				"operationId": "ImportWorkflow",
				"responses": {
					"201": {
						"description": "Imported"
					},
					"400": {
						"description": "Bad Request"
					},
					"409": {
						"description": "Workflow exists"
					}
				},
				"description": "Imports a workflow package, using the same structure as the FFAStrans\ndesktop \"Import workflow\" feature and the export endpoint: a body of\n`{ workflow, presets?, user_variables? }` (a bare workflow object is also\naccepted for backward compatibility). The workflow is created and must\nnot already exist; bundled presets are installed and bundled user\nvariables/statics are merged in (existing names and the reserved system\nvariables are left untouched).",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"description": "The workflow package (or a bare workflow definition) to import.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"description": "The workflow package (or a bare workflow definition) to import."
							}
						}
					}
				}
			},
			"put": {
				"operationId": "UpdateWorkflow",
				"responses": {
					"200": {
						"description": "Updated"
					},
					"201": {
						"description": "Created"
					},
					"400": {
						"description": "Bad Request"
					}
				},
				"description": "Creates or updates a workflow. This is an idempotent operation.\nIf the workflow ID in the body exists, it will be updated.\nIf it does not exist, a new workflow will be created.",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"description": "The full JSON definition of the workflow.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"description": "The full JSON definition of the workflow."
							}
						}
					}
				}
			}
		},
		"/api/v2/workflows/status": {
			"get": {
				"operationId": "ListWorkflowStatuses",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {}
							}
						}
					}
				},
				"description": "Retrieves requested monitor states from shared markers. The legacy status\nrunning means marked to run, without verifying runner health or job execution.",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": []
			}
		},
		"/api/v2/workflows/{wf_id}": {
			"get": {
				"operationId": "GetWorkflow",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WorkflowResponse"
								}
							}
						}
					},
					"404": {
						"description": "Not Found"
					}
				},
				"description": "Retrieves the full definition of a specific workflow by its ID.",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": [
					{
						"description": "The GUID of the workflow to retrieve.",
						"in": "path",
						"name": "wf_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			},
			"put": {
				"operationId": "ControlWorkflow",
				"responses": {
					"202": {
						"description": "Monitor request accepted",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WorkflowControlResult"
								}
							}
						}
					},
					"400": {
						"description": "Bad Request"
					},
					"404": {
						"description": "Not Found"
					},
					"409": {
						"description": "Conflict"
					}
				},
				"description": "Changes requested monitor state and returns the resulting markers.\nstop/disable remove the manager's start request; existing submitted jobs\ncontinue. reset clears matching pending tickets and monitor cache.",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": [
					{
						"description": "The GUID of the workflow to control.",
						"in": "path",
						"name": "wf_id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"description": "The action to perform on the workflow.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/WorkflowActionRequest",
								"description": "The action to perform on the workflow."
							}
						}
					}
				}
			},
			"delete": {
				"operationId": "DeleteWorkflow",
				"responses": {
					"202": {
						"description": "Deleted"
					},
					"400": {
						"description": "Bad Request"
					},
					"404": {
						"description": "Not Found"
					}
				},
				"description": "Requests monitor stop, archives the workflow, and clears disabled state.\nPending and executing jobs retain their normal core lifecycle.",
				"tags": [
					"Workflows"
				],
				"security": [],
				"parameters": [
					{
						"description": "The GUID of the workflow to delete.",
						"in": "path",
						"name": "wf_id",
